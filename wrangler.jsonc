{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "macon170-cms",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "cms.macon170.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "macon170-cms",
      "database_id": "b3282c32-5fa3-4612-a4d2-757bcf64f67f",
      "migrations_dir": "./node_modules/@sonicjs-cms/core/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA_BUCKET", "bucket_name": "macon170-cms-media" }],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["volunteers@macon170.com"]
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "17004",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "vars": {
    "APP_VERSION": "development",
    "ENVIRONMENT": "production",
    "CORS_ORIGINS": "https://www.macon170.com",
    "PUBLIC_SITE_ORIGIN": "https://www.macon170.com",
    "INVITE_FROM_EMAIL": "volunteers@macon170.com",
    "INVITE_FROM_NAME": "Pack 170 Volunteers",
    "INVITE_REPLY_TO": "contact@macon170.com",
    "TURNSTILE_EXPECTED_ACTION": "turnstile-spin-v2",
    "TURNSTILE_EXPECTED_HOSTNAMES": "macon170.com,www.macon170.com"
  },
  // TURNSTILE_SECRET is a Worker secret. Configure it separately before contact cutover.
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
