# Copy this file to .dev.vars for local-only CMS development.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:41771,http://kudzu:41771
PUBLIC_SITE_ORIGIN=http://localhost:41771
JWT_SECRET=generate-a-unique-local-secret
INVITE_FROM_EMAIL=volunteers@macon170.com
INVITE_FROM_NAME=Pack 170 Volunteers
INVITE_REPLY_TO=contact@macon170.com
# This token validates Postmark requests without sending email. Never use it in
# production. Both volunteer invitations and signup confirmations use the
# Macon170.com Server API Token stored as POSTMARK_SERVER_TOKEN in production.
POSTMARK_SERVER_TOKEN=POSTMARK_API_TEST
# Cloudflare's documented always-pass test secret. Replace only in the ignored
# .dev.vars file; configure the real value with `wrangler secret put` in production.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
BROADCAST_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Email broadcasts: configure a Postmark Broadcast stream before live sending.
# BROADCAST_FROM_EMAIL=volunteers@macon170.com
# BROADCAST_STREAM=broadcast
# BROADCAST_ORIGIN=http://localhost:41772
# BROADCAST_WEBHOOK_SECRET=replace-with-a-random-local-secret
# BROADCAST_UNSUBSCRIBE_MODE=postmark

# Match the externally reachable Worker origin when testing ChatGPT locally.
MCP_ORIGIN=http://localhost:41772
