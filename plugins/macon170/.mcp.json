{
  "mcpServers": {
    "macon170": {
      "type": "streamable-http",
      "url": "https://cms.macon170.com/mcp",
      "headers": {},
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://cms.macon170.com/mcp",
            "defaultScopes": [
              "cms:read",
              "cms:write",
              "cms:send"
            ]
          }
        }
      }
    }
  }
}
